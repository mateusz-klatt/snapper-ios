    "notifications.devicePref.quietHours.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-critical alerts are deferred during this window, using the device timezone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty inne niż krytyczne są wstrzymywane w tym oknie czasowym, według strefy czasowej urządzenia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht kritische Alarme werden in diesem Zeitfenster zurückgehalten, basierend auf der Geräte-Zeitzone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes non critiques sont différées pendant cette plage horaire, selon le fuseau horaire de l'appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas no críticas se aplazan durante este intervalo, usando la zona horaria del dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le allerte non critiche sono rinviate durante questo intervallo, in base al fuso orario del dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-kritieke alerts worden tijdens dit venster uitgesteld, op basis van de tijdzone van het apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas não críticos são adiados durante esta janela, usando o fuso horário do dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Icke-kritiska larm skjuts upp under detta fönster, enligt enhetens tidszon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke-kritiske varsler utsettes i dette tidsrommet, basert på enhetens tidssone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke-kritiske alarmer udskydes i dette tidsrum, baseret på enhedens tidszone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei-kriittiset hälytykset siirretään tämän aikaikkunan ajaksi laitteen aikavyöhykkeen mukaan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekritická upozornění jsou v tomto okně odložena, podle časového pásma zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekritické upozornenia sú v tomto okne odložené podľa časovej zóny zariadenia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nem kritikus riasztások ebben az időablakban késleltetve vannak, az eszköz időzónája szerint."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele necritice sunt amânate în acest interval, conform fusului orar al dispozitivului."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekritična upozorenja odgađaju se tijekom ovog razdoblja, prema vremenskoj zoni uređaja."
          }
        }
      }
    },
    "notifications.devicePref.scope.footer.editLocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit mode preserves the original scope. The selected operator and wallet are part of the alert's identity and cannot be changed here."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb edycji zachowuje pierwotny zakres. Wybrany operator i portfel są częścią tożsamości alertu i nie można ich tutaj zmienić."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bearbeitungsmodus erhält den ursprünglichen Bereich. Der gewählte Operator und das Wallet sind Teil der Alarm-Identität und können hier nicht geändert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode édition préserve la portée d'origine. L'opérateur et le portefeuille sélectionnés font partie de l'identité de l'alerte et ne peuvent pas être modifiés ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de edición preserva el ámbito original. El operador y la wallet seleccionados forman parte de la identidad de la alerta y no se pueden cambiar aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità di modifica preserva l'ambito originale. L'operatore e il wallet selezionati fanno parte dell'identità dell'allerta e non possono essere modificati qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewerkingsmodus behoudt het oorspronkelijke bereik. De geselecteerde operator en wallet maken deel uit van de identiteit van de alert en kunnen hier niet worden gewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de edição preserva o escopo original. O operador e a carteira selecionados fazem parte da identidade do alerta e não podem ser alterados aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigeringsläget bevarar den ursprungliga omfattningen. Vald operatör och plånbok är en del av larmets identitet och kan inte ändras här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigeringsmodus bevarer det opprinnelige omfanget. Valgt operatør og lommebok er en del av varselets identitet og kan ikke endres her."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigeringstilstand bevarer det oprindelige område. Den valgte operatør og wallet er en del af alarmens identitet og kan ikke ændres her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaustila säilyttää alkuperäisen laajuuden. Valittu operaattori ja lompakko ovat osa hälytyksen identiteettiä, eikä niitä voi muuttaa täältä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim úprav zachovává původní rozsah. Vybraný operátor a peněženka jsou součástí identity upozornění a nelze je zde měnit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim úprav zachováva pôvodný rozsah. Vybraný operátor a peňaženka sú súčasťou identity upozornenia a nemožno ich tu zmeniť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerkesztés mód megőrzi az eredeti hatókört. A kiválasztott operátor és pénztárca a riasztás azonosságának része, és itt nem módosíthatóak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul de editare păstrează domeniul original. Operatorul și portofelul selectate fac parte din identitatea alertei și nu pot fi modificate aici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Način uređivanja čuva izvorni opseg. Odabrani operator i novčanik dio su identiteta upozorenja i ne mogu se ovdje promijeniti."
          }
        }
      }
    },
    "notifications.devicePref.scope.footer.loadingOperators": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading operators… If the list stays empty, your account has no operator memberships and only Device scope is available."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytywanie operatorów… Jeśli lista pozostanie pusta, Twoje konto nie ma przypisanych operatorów i dostępny jest tylko zakres Urządzenie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatoren werden geladen… Bleibt die Liste leer, hat dein Konto keine Operator-Mitgliedschaften und nur der Bereich „Gerät“ ist verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des opérateurs… Si la liste reste vide, votre compte n'a aucune adhésion à un opérateur et seule la portée Appareil est disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando operadores… Si la lista permanece vacía, tu cuenta no tiene operadores asociados y solo el ámbito Dispositivo está disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento operatori… Se la lista rimane vuota, il tuo account non ha appartenenze a operatori ed è disponibile solo l'ambito Dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operators laden… Als de lijst leeg blijft, heeft je account geen operator-lidmaatschappen en is alleen het bereik Apparaat beschikbaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando operadores… Se a lista permanecer vazia, sua conta não tem vínculos com operadores e apenas o escopo Dispositivo está disponível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar operatörer… Om listan förblir tom har ditt konto inga operatörsmedlemskap och endast omfattningen Enhet är tillgänglig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster operatører… Hvis listen forblir tom, har kontoen din ingen operatørmedlemskap, og bare omfanget Enhet er tilgjengelig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæser operatører… Hvis listen forbliver tom, har din konto ingen operatørmedlemskaber, og kun området Enhed er tilgængeligt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladataan operaattoreita… Jos lista jää tyhjäksi, tilillesi ei ole määritetty operaattoreita ja vain Laite-laajuus on käytettävissä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítání operátorů… Pokud seznam zůstane prázdný, váš účet nemá žádná členství v operátorech a je dostupný pouze rozsah Zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítavanie operátorov… Ak zoznam zostane prázdny, váš účet nemá členstvá u operátorov a dostupný je iba rozsah Zariadenie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Operátorok betöltése… Ha a lista üres marad, fiókja nem rendelkezik operátortagsággal, és csak az Eszköz hatókör érhető el."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă operatorii… Dacă lista rămâne goală, contul tău nu are afilieri de operator și este disponibil doar domeniul Dispozitiv."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitavanje operatora… Ako lista ostane prazna, vaš račun nema članstva kod operatora i dostupan je samo opseg Uređaj."
          }
        }
      }
    },
