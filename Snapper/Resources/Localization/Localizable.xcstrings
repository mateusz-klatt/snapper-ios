        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltryck för att öppna larmdetaljer"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å åpne varseldetaljer"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttryk for at åbne alarmdetaljer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa hälytyksen tiedot kaksoisnapauttamalla"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím otevřete detaily upozornění"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým ťuknutím otvoríte podrobnosti upozornenia"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson duplán a riasztás részleteinek megnyitásához"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge de două ori pentru a deschide detaliile alertei"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite za prikaz detalja upozorenja"
          }
        }
      }
    },
