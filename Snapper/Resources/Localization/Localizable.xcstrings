    "positions.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positions will appear here when you have open orders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje pojawią się tu, gdy masz otwarte zlecenia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positionen erscheinen hier, sobald du offene Orders hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions apparaîtront ici lorsque vous aurez des ordres ouverts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones aparecerán aquí cuando tengas órdenes abiertas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le posizioni appariranno qui quando avrai ordini aperti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posities verschijnen hier zodra je open orders hebt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições aparecerão aqui quando você tiver ordens abertas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Positioner visas här när du har öppna ordrar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjoner vises her når du har åpne ordrer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Positioner vises her, når du har åbne ordrer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiot näkyvät täällä, kun sinulla on avoimia toimeksiantoja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozice se zde objeví, jakmile budete mít otevřené pokyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozície sa zobrazia tu, keď budete mať otvorené pokyny."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pozíciók itt jelennek meg, amikor nyitott megbízásai vannak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozițiile vor apărea aici când vei avea ordine deschise."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozicije će se pojaviti ovdje kad imate otvorene naloge."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиції зʼявляться тут, коли у вас будуть відкриті ордери."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиции появятся здесь, когда у вас будут открытые ордера."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozicijos bus rodomos čia, kai turėsite atvirų pavedimų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozīcijas parādīsies šeit, kad būs atvērti rīkojumi."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozicije će se pojaviti ovde kada imate otvorene naloge."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozicije će se pojaviti ovdje kada imate otvorene naloge."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozicionet do të shfaqen këtu kur të kesh porosi të hapura."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöður birtast hér þegar þú ert með opnar pantanir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι θέσεις θα εμφανιστούν εδώ όταν έχετε ανοιχτές εντολές."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık emirleriniz olduğunda pozisyonlar burada görünecek."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga position kapag mayroon kang mga bukas na order."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisi akan muncul di sini apabila anda mempunyai pesanan terbuka."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisi akan muncul di sini ketika Anda memiliki pesanan terbuka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Position zitaonekana hapa ukiwa na order zilizo wazi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওপেন অর্ডার থাকলে পজিশন এখানে দেখা যাবে।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你有未成交订单时，仓位会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你有未完成訂單時，倉位會顯示在此。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンポジションがあるとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주문이 열려 있으면 포지션이 여기에 표시됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะจะแสดงที่นี่เมื่อคุณมีคำสั่งที่เปิดอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị thế sẽ xuất hiện ở đây khi bạn có lệnh đang mở."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "open orders ရှိသည့်အခါ position များ ဤနေရာတွင် ပေါ်လာမည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपके पास ओपन ऑर्डर होंगे, पोज़ीशन यहां दिखाई देंगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر المراكز هنا عندما تكون لديك أوامر مفتوحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוזיציות יופיעו כאן כשיהיו לך פקודות פתוחות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی سفارش‌های باز داشته باشید، موقعیت‌ها اینجا نمایش داده می‌شوند."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դիրքերը այստեղ կհայտնվեն, երբ բաց հանձնարարականներ ունենաք։"
          }
        }
      }
    },
