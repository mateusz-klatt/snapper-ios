    "notifications.devicePref.hardMute.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard mute overrides quiet hours and disables every alert in this scope until the chosen time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełne wyciszenie pomija ciche godziny i wyłącza wszystkie alerty w tym zakresie do wybranego czasu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollstummschaltung überschreibt Ruhezeiten und deaktiviert alle Alarme in diesem Bereich bis zur gewählten Zeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le silence total ignore les heures silencieuses et désactive toutes les alertes dans cette portée jusqu'à l'heure choisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El silencio total ignora las horas de silencio y desactiva todas las alertas en este ámbito hasta la hora elegida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il silenzio totale ignora le ore di silenzio e disattiva ogni allerta in questo ambito fino all'orario scelto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard dempen negeert stille uren en schakelt alle alerts in dit bereik uit tot het gekozen tijdstip."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O silenciamento total ignora o horário silencioso e desativa todos os alertas neste escopo até o horário escolhido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hård tystning åsidosätter tysta timmar och inaktiverar alla larm i denna omfattning fram till vald tid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard demping overstyrer stille timer og deaktiverer alle varsler i dette omfanget frem til valgt tid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hård mute tilsidesætter stille timer og deaktiverer alle alarmer i dette område indtil det valgte tidspunkt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysmykistys ohittaa hiljaiset tunnit ja poistaa käytöstä kaikki tämän laajuuden hälytykset valittuun aikaan asti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdé ztlumení přepíše tiché hodiny a vypne všechna upozornění v tomto rozsahu až do zvoleného času."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdé stlmenie obchádza tiché hodiny a vypína všetky upozornenia v tomto rozsahu až do zvoleného času."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes némítás felülírja a csendes órákat és letilt minden riasztást ebben a hatókörben a kiválasztott időpontig."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Silențierea totală ignoră orele silențioase și dezactivează toate alertele din acest domeniu până la ora aleasă."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpuno utišavanje nadjačava tihe sate i onemogućuje sva upozorenja u ovom opsegu do odabranog vremena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повне вимкнення звуку має пріоритет над годинами тиші та вимикає всі сповіщення в цій області до вказаного часу."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полное заглушение игнорирует тихие часы и отключает все оповещения в этой области до выбранного времени."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilnas nutildymas pakeičia tylos valandas ir išjungia visus šios apimties įspėjimus iki pasirinkto laiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilna apklusināšana ignorē klusās stundas un atspējo visus brīdinājumus šajā tvērumā līdz izvēlētajam laikam."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpuno utišavanje nadjačava tihe sate i onemogućava sva upozorenja u ovom opsegu do izabranog vremena."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpuno utišavanje zaobilazi tihe sate i onemogućuje sva upozorenja u ovom opsegu do izabranog vremena."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Heshtja e plotë anashkalon orët e qetësisë dhe çaktivizon çdo sinjalizim në këtë fushëveprim deri në kohën e zgjedhur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Algjör þöggun gengur framar kyrrðartímum og slekkur á öllum viðvörunum í þessu umfangi til valins tíma."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πλήρης σίγαση παρακάμπτει τις ώρες ησυχίας και απενεργοποιεί κάθε ειδοποίηση σε αυτό το πεδίο μέχρι την επιλεγμένη ώρα."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıkı sessize alma, sessiz saatleri geçersiz kılar ve seçilen süreye kadar bu kapsamdaki tüm uyarıları devre dışı bırakır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapalitan ng hard mute ang quiet hours at hindi pinapagana ang bawat alerto sa scope na ito hanggang sa napiling oras."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisu penuh mengatasi waktu senyap dan menyahdayakan setiap amaran dalam skop ini sehingga masa yang dipilih."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisu penuh mengabaikan jam tenang dan menonaktifkan semua peringatan dalam cakupan ini hingga waktu yang dipilih."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard mute hupita saa za utulivu na huzima kila arifa katika wigo huu hadi wakati uliochaguliwa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হার্ড মিউট নীরব সময় অগ্রাহ্য করে এবং নির্বাচিত সময় পর্যন্ত এই স্কোপের সব অ্যালার্ট বন্ধ করে।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制静音会覆盖免打扰时段，并在所选时间前禁用此范围内的所有提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制靜音會覆蓋靜音時段，並在所選時間前停用此範圍內所有警示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強制ミュートはサイレント時間を上書きし、選択した時刻までこの範囲のすべてのアラートを無効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드 음소거는 무음 시간을 무시하고 지정된 시각까지 이 범위의 모든 알림을 비활성화합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเสียงทั้งหมดจะทับช่วงเวลางดรบกวนและปิดการแจ้งเตือนทั้งหมดในขอบเขตนี้จนถึงเวลาที่เลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt tiếng cứng bỏ qua giờ yên tĩnh và vô hiệu hóa mọi cảnh báo trong phạm vi này cho đến thời điểm đã chọn."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard mute သည် quiet hours ကို ကျော်လွန်ပြီး ရွေးထားသောအချိန်အထိ ဤ scope အတွင်းရှိ alert အားလုံးကို ပိတ်ထားပါသည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हार्ड म्यूट शांत घंटों को ओवरराइड करता है और चुने गए समय तक इस स्कोप के हर अलर्ट को अक्षम कर देता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتم التام يتجاوز ساعات الهدوء ويعطل كل تنبيه في هذا النطاق حتى الوقت المختار."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתקה מלאה עוקפת שעות שקטות ומשביתה כל התראה בטווח הזה עד הזמן שנבחר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بی‌صدایی کامل ساعات سکوت را نادیده می‌گیرد و تا زمان انتخاب‌شده همه هشدارهای این دامنه را غیرفعال می‌کند."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամբողջական լռեցումը գերակայում է լռության ժամերին և անջատում է այս շրջանակի բոլոր ազդանշանները մինչև ընտրված ժամը։"
          }
        }
      }
    },
