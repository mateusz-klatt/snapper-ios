    "notifications.devicePref.hardMute.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard mute overrides quiet hours and disables every alert in this scope until the chosen time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełne wyciszenie pomija ciche godziny i wyłącza wszystkie alerty w tym zakresie do wybranego czasu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollstummschaltung überschreibt Ruhezeiten und deaktiviert alle Alarme in diesem Bereich bis zur gewählten Zeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le silence total ignore les heures silencieuses et désactive toutes les alertes dans cette portée jusqu'à l'heure choisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El silencio total ignora las horas de silencio y desactiva todas las alertas en este ámbito hasta la hora elegida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il silenzio totale ignora le ore di silenzio e disattiva ogni allerta in questo ambito fino all'orario scelto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard dempen negeert stille uren en schakelt alle alerts in dit bereik uit tot het gekozen tijdstip."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O silenciamento total ignora o horário silencioso e desativa todos os alertas neste escopo até o horário escolhido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hård tystning åsidosätter tysta timmar och inaktiverar alla larm i denna omfattning fram till vald tid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard demping overstyrer stille timer og deaktiverer alle varsler i dette omfanget frem til valgt tid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hård mute tilsidesætter stille timer og deaktiverer alle alarmer i dette område indtil det valgte tidspunkt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysmykistys ohittaa hiljaiset tunnit ja poistaa käytöstä kaikki tämän laajuuden hälytykset valittuun aikaan asti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdé ztlumení přepíše tiché hodiny a vypne všechna upozornění v tomto rozsahu až do zvoleného času."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdé stlmenie obchádza tiché hodiny a vypína všetky upozornenia v tomto rozsahu až do zvoleného času."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes némítás felülírja a csendes órákat és letilt minden riasztást ebben a hatókörben a kiválasztott időpontig."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Silențierea totală ignoră orele silențioase și dezactivează toate alertele din acest domeniu până la ora aleasă."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpuno utišavanje nadjačava tihe sate i onemogućuje sva upozorenja u ovom opsegu do odabranog vremena."
          }
        }
      }
    },
