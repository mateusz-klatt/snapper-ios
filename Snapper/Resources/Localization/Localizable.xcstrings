    "notifications.prefs.noDevice.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable push notifications in Settings → Notifications to register this device."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz powiadomienia push w Ustawienia → Powiadomienia, aby zarejestrować to urządzenie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Push-Benachrichtigungen unter Einstellungen → Benachrichtigungen, um dieses Gerät zu registrieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications push dans Réglages → Notifications pour enregistrer cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones push en Ajustes → Notificaciones para registrar este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita le notifiche push in Impostazioni → Notifiche per registrare questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel pushmeldingen in via Instellingen → Meldingen om dit apparaat te registreren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações push em Ajustes → Notificações para registrar este dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera push-aviseringar i Inställningar → Aviseringar för att registrera den här enheten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver push-varsler i Innstillinger → Varsler for å registrere denne enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér push-notifikationer i Indstillinger → Notifikationer for at registrere denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota push-ilmoitukset käyttöön kohdassa Asetukset → Ilmoitukset rekisteröidäksesi tämän laitteen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte push oznámení v Nastavení → Oznámení, abyste toto zařízení zaregistrovali."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite push upozornenia v Nastavenia → Upozornenia, aby sa toto zariadenie zaregistrovalo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a push értesítéseket a Beállítások → Értesítések menüben az eszköz regisztrálásához."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează notificările push din Setări → Notificări pentru a înregistra acest dispozitiv."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite push obavijesti u Postavke → Obavijesti za registraciju ovog uređaja."
          }
        }
      }
    },
