    "positions.reduce.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% closes the position. Submits a reduce-only market order against the opposite side."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "100% zamyka pozycję. Wysyła zlecenie rynkowe reduce-only po przeciwnej stronie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % schließt die Position. Übermittelt eine Reduce-Only-Marktorder gegen die Gegenseite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % clôture la position. Envoie un ordre au marché reduce-only sur le sens opposé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "100% cierra la posición. Envía una orden de mercado reduce-only en el lado contrario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 100% chiude la posizione. Invia un ordine a mercato reduce-only sul lato opposto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
