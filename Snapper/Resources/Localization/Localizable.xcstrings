    "notifications.prefs.section.userDefaults.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults apply when no per-device override matches an inbound alert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia domyślne mają zastosowanie, gdy żadne nadpisanie dla urządzenia nie pasuje do przychodzącego alertu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardeinstellungen greifen, wenn keine geräteindividuelle Überschreibung auf einen eingehenden Alarm passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs par défaut s'appliquent lorsque aucun remplacement spécifique à l'appareil ne correspond à une alerte entrante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores predeterminados se aplican cuando ninguna anulación de dispositivo coincide con una alerta entrante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori predefiniti si applicano quando nessun override del dispositivo corrisponde a un'allerta in arrivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardwaarden gelden wanneer geen apparaatspecifieke override overeenkomt met een binnenkomende alert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões se aplicam quando nenhuma substituição por dispositivo corresponde a um alerta recebido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardvärden gäller när inget enhetsspecifikt åsidosättande matchar ett inkommande larm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard gjelder når ingen enhetsspesifikk overstyring samsvarer med et innkommende varsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarder gælder, når ingen enheds-tilsidesættelse matcher en indkommende alarm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletukset ovat voimassa, kun mikään laitekohtainen ohitus ei vastaa saapuvaa hälytystä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí hodnoty se použijí, když žádné přepsání pro zařízení neodpovídá příchozímu upozornění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolené nastavenia platia, keď žiadny prepis zariadenia nezodpovedá prichádzajúcemu upozorneniu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértékek akkor érvényesülnek, ha egyetlen eszközszintű felülírás sem illeszkedik egy beérkező riasztásra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile implicite se aplică atunci când nicio suprascriere specifică dispozitivului nu se potrivește cu o alertă primită."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadane postavke primjenjuju se kad nijedna iznimka uređaja ne odgovara dolaznom upozorenju."
          }
        }
      }
    },
    "trading.bracket.footer.requirement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one of stop loss / take profit is required. Backend fires reduce-only protective orders when price crosses either level."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest co najmniej stop loss lub take profit. Backend wysyła ochronne zlecenia reduce-only, gdy cena przekroczy któryś z poziomów."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens Stop-Loss oder Take-Profit ist erforderlich. Das Backend sendet Reduce-Only-Schutzorder, sobald der Preis eine der beiden Schwellen überschreitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un stop loss ou take profit est requis. Le backend déclenche des ordres de protection reduce-only lorsque le prix franchit l'un des niveaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere al menos uno de stop loss o take profit. El backend envía órdenes protectoras reduce-only cuando el precio cruza cualquiera de los niveles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È richiesto almeno uno tra stop loss e take profit. Il backend invia ordini protettivi reduce-only quando il prezzo supera uno dei due livelli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten minste een stop loss of een take profit is vereist. De backend verstuurt reduce-only beschermingsorders zodra de prijs een van beide niveaus overschrijdt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos um entre stop loss e take profit é obrigatório. O backend dispara ordens de proteção reduce-only quando o preço cruzar qualquer um dos níveis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst en av stop loss / take profit krävs. Backend skickar reduce-only-skyddsordrar när priset korsar någon av nivåerna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst én av stop loss / take profit kreves. Backend sender beskyttende reduce-only-ordrer når prisen krysser et av nivåene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindst en af stop loss eller take profit er påkrævet. Backend udsender reduce-only beskyttelsesordrer, når prisen krydser et af niveauerne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaaditaan vähintään stop loss tai take profit. Backend lähettää reduce-only-suojaustoimeksiantoja, kun hinta ylittää jommankumman tason."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje se alespoň jedno ze stop loss / take profit. Backend odesílá ochranné reduce-only pokyny, jakmile cena překročí kteroukoli z úrovní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje sa aspoň jedno zo stop loss / take profit. Backend pri prekročení niektorej úrovne odošle ochranné pokyny reduce-only."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább egy stop loss vagy take profit szükséges. A backend reduce-only védelmi megbízásokat indít, amikor az ár átlépi bármelyik szintet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este necesar cel puțin un stop loss sau un take profit. Backendul trimite ordine de protecție reduce-only când prețul depășește unul dintre niveluri."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban je barem stop loss ili take profit. Backend šalje zaštitne reduce-only naloge kad cijena prijeđe neku od razina."
          }
        }
      }
    },
