          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % uždaro poziciją. Pateikia tik mažinantį (reduce-only) rinkos pavedimą priešingoje pusėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "100% aizver pozīciju. Nosūta reduce-only tirgus rīkojumu pretējā pusē."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
