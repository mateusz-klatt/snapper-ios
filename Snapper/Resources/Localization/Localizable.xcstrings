          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma nadpisań."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Gerät gibt es keine geräteindividuellen Überschreibungen."
