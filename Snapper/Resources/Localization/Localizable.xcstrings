    "backend.url.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Casual users can ignore this. Self-hosters set the URL of their own Snapper backend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykli użytkownicy mogą to zignorować. Self-hosterzy ustawiają tu URL własnego backendu Snappera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelegenheitsnutzer können dies ignorieren. Self-Hoster tragen hier die URL ihres eigenen Snapper-Backends ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs ordinaires peuvent ignorer ceci. Les self-hosters renseignent l'URL de leur propre backend Snapper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios normales pueden ignorar esto. Los self-hosters configuran aquí la URL de su propio backend de Snapper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti comuni possono ignorare questa opzione. I self-hoster impostano qui l'URL del proprio backend Snapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewone gebruikers kunnen dit negeren. Self-hosters stellen hier de URL van hun eigen Snapper-backend in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários comuns podem ignorar isto. Quem faz self-hosting define aqui a URL do próprio backend do Snapper."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanliga användare kan ignorera detta. Self-hosters anger URL:en till sin egen Snapper-backend."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlige brukere kan ignorere dette. Selv-hostere setter URL-en til sin egen Snapper-backend."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Almindelige brugere kan ignorere dette. Self-hostere angiver URL'en til deres egen Snapper-backend."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavalliset käyttäjät voivat ohittaa tämän. Itse hostaavat asettavat oman Snapper-backendinsa URL-osoitteen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžní uživatelé to mohou ignorovat. Self-hosteři zde nastavují URL vlastního backendu Snapper."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bežní používatelia to môžu ignorovať. Self-hosteri si tu nastavujú URL vlastného Snapper backendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átlagos felhasználók ezt figyelmen kívül hagyhatják. A self-host felhasználók itt állítják be saját Snapper backendjük URL-jét."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizatorii obișnuiți pot ignora această opțiune. Cei care găzduiesc propriul server setează aici URL-ul backendului Snapper."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obični korisnici mogu ovo zanemariti. Self-hosteri postavljaju URL vlastitog Snapper backenda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайні користувачі можуть це проігнорувати. Self-hosters вказують URL власного backendʼу Snapper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычные пользователи могут это проигнорировать. Self-hosters указывают здесь URL собственного бэкенда Snapper."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įprasti naudotojai gali to nepaisyti. Save talpinantys naudotojai čia nurodo savo Snapper backend'o URL."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parastie lietotāji to var ignorēt. Pašmitinātāji norāda sava Snapper backend URL."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Obični korisnici mogu ovo zanemariti. Self-hosteri postavljaju URL sopstvenog Snapper backenda."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obični korisnici mogu ovo zanemariti. Self-hosteri postavljaju URL vlastitog Snapper backenda."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përdoruesit e zakonshëm mund ta shpërfillin këtë. Ata që hostojnë vetë vendosin URL-në e backend-it të tyre Snapper."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Almennir notendur geta hunsað þetta. Þeir sem hýsa sjálfir stilla URL-ið fyrir eigið Snapper-backend."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι περιστασιακοί χρήστες μπορούν να το αγνοήσουν. Όσοι κάνουν self-host ορίζουν εδώ το URL του δικού τους Snapper backend."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradan kullanıcılar bunu yok sayabilir. Self-hosting yapanlar kendi Snapper backend'lerinin URL'sini ayarlar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring balewalain ito ng mga casual user. Itinatakda ng mga self-hoster ang URL ng kanilang sariling Snapper backend."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna biasa boleh abaikan ini. Self-hoster menetapkan URL backend Snapper mereka sendiri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna biasa dapat mengabaikan ini. Self-hoster mengatur URL backend Snapper mereka sendiri."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Watumiaji wa kawaida wanaweza kupuuza hili. Wanao-host wenyewe waweke URL ya backend yao ya Snapper."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণ ব্যবহারকারীরা এটি উপেক্ষা করতে পারেন। self-hosters নিজেদের Snapper ব্যাকএন্ডের URL সেট করবেন।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通用户可以忽略此项。自托管用户可设置自己的 Snapper 后端 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般用戶可忽略此項。自行託管者請設定自己的 Snapper 後端 URL。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のユーザーは無視できます。セルフホストする場合は、自分のSnapperバックエンドのURLを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 사용자는 무시해도 됩니다. 셀프 호스팅 사용자는 자체 Snapper 백엔드 URL을 설정합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้ทั่วไปสามารถข้ามส่วนนี้ได้ ผู้ที่ self-host ให้ตั้งค่า URL ของ backend Snapper ของตนเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng thông thường có thể bỏ qua. Người tự host đặt URL của backend Snapper riêng."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သာမန်အသုံးပြုသူများ ဤအရာကို လျစ်လျူရှုနိုင်သည်။ Self-hosters များသည် ကိုယ်ပိုင် Snapper backend ၏ URL ကို သတ်မှတ်ပါသည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य यूज़र इसे अनदेखा कर सकते हैं। सेल्फ-होस्टर अपने स्नैपर बैकएंड का यूआरएल सेट करते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمستخدمين العاديين تجاهل هذا. يضبط المستضيفون ذاتيًا رابط خادم Snapper الخلفي الخاص بهم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמשים רגילים יכולים להתעלם מזה. מי שמארחים בעצמם מגדירים כאן את כתובת ה-URL של בקאנד Snapper שלהם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاربران عادی می‌توانند این بخش را نادیده بگیرند. کاربران self-host آدرس بک‌اند Snapper خودشان را اینجا تنظیم می‌کنند."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սովորական օգտատերերը կարող են անտեսել սա։ Ինքնուրույն host անողները սահմանում են իրենց Snapper backend-ի URL-ը։"
          }
        }
      }
    },
    "backend.url.invalidDebug": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use https:// (or http:// for localhost in Debug). Origin only — no path, query, or fragment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj https:// (lub http:// dla localhost w Debug). Tylko origin — bez ścieżki, parametrów ani fragmentu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende https:// (oder http:// für localhost im Debug-Modus). Nur Origin — kein Pfad, keine Query, kein Fragment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez https:// (ou http:// pour localhost en Debug). Origine uniquement — sans chemin, requête ni fragment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https:// (o http:// para localhost en Debug). Solo origin — sin ruta, parámetros ni fragmento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https:// (o http:// per localhost in Debug). Solo origin — senza path, query o frammento."
          }
        },
