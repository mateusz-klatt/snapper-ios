    "alerts.accessibility.hint.row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to open alert details"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij dwukrotnie, aby zobaczyć szczegóły alertu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um Alarmdetails zu öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour afficher les détails de l'alerte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para ver los detalles de la alerta"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per aprire i dettagli dell'allerta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltik om alertdetails te openen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para abrir os detalhes do alerta"
