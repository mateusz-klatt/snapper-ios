    "alerts.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New alerts will appear here when they fire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe alerty pojawią się tu, gdy zostaną wyzwolone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Alarme erscheinen hier, sobald sie ausgelöst werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles alertes apparaîtront ici lorsqu'elles se déclencheront."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas alertas aparecerán aquí cuando se activen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove allerte appariranno qui quando verranno attivate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe alerts verschijnen hier zodra ze worden geactiveerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos alertas aparecerão aqui quando forem disparados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nya larm visas här när de utlöses."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye varsler vises her når de utløses."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye alarmer vises her, når de udløses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet hälytykset näkyvät täällä, kun ne laukeavat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová upozornění se objeví zde, jakmile budou spuštěna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nové upozornenia sa zobrazia tu, keď sa spustia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új riasztások itt jelennek meg, amikor aktiválódnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele noi vor apărea aici când sunt declanșate."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova upozorenja pojavit će se ovdje kad se aktiviraju."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові сповіщення з'являться тут, коли вони спрацюють."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые оповещения появятся здесь, когда они сработают."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauji įspėjimai bus rodomi čia, kai jie suveiks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jauni brīdinājumi parādīsies šeit, kad tie tiks aktivizēti."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova upozorenja pojaviće se ovde kada se aktiviraju."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova upozorenja pojavit će se ovdje kad se aktiviraju."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinjalizimet e reja do të shfaqen këtu kur të aktivizohen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nýjar viðvaranir birtast hér þegar þær virkjast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νέες ειδοποιήσεις θα εμφανιστούν εδώ όταν ενεργοποιηθούν."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni uyarılar tetiklendiğinde burada görünecek."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga bagong alerto kapag na-trigger ang mga ito."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran baharu akan muncul di sini apabila dicetuskan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan baru akan muncul di sini ketika terpicu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Arifa mpya zitaonekana hapa zitakapowashwa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন অ্যালার্ট ট্রিগার হলে এখানে দেখা যাবে।"
          }
        }
      }
    },
