        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 将平掉该仓位。提交一笔相反方向的只减仓市价订单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 會平掉倉位。提交一張相反方向的只減倉市價訂單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100%でポジションをクローズします。反対サイドに対してリデュースオンリーの成行注文を送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100%는 포지션을 청산합니다. 반대 방향으로 reduce-only 시장가 주문을 전송합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "100% จะปิดสถานะ ส่งคำสั่งมาร์เก็ตแบบ reduce-only ในฝั่งตรงข้าม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "100% đóng vị thế. Gửi lệnh thị trường reduce-only ngược phía."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "100% သည် position ကို ပိတ်ပါမည်။ ဆန့်ကျင်ဘက် side အပေါ် reduce-only market order တင်သွင်းပါသည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "100% पोज़ीशन बंद कर देता है। विपरीत साइड पर रिड्यूस-ओनली मार्केट ऑर्डर सबमिट करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "100% يغلق المركز. يُرسل أمر سوق للتقليل فقط على الجانب المعاكس."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "100% סוגר את הפוזיציה. שולח פקודת שוק reduce-only בצד הנגדי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "100% موقعیت را می‌بندد. یک سفارش مارکت reduce-only در سمت مخالف ارسال می‌کند."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "100%-ը փակում է դիրքը։ Ուղարկում է reduce-only շուկայական հանձնարարական հակառակ ուղղությամբ։"
          }
        }
      }
    },
