        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik dua kali untuk log keluar dan kembali ke log masuk"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk keluar dan kembali ke login"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa mara mbili kutoka na kurudi kwenye login"
