          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % sulkee position. Lähettää reduce-only-markkinatoimeksiannon vastakkaiselle puolelle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % zavírá pozici. Odešle se reduce-only tržní pokyn na opačnou stranu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % zatvorí pozíciu. Odošle trhový pokyn reduce-only proti opačnej strane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 100% lezárja a pozíciót. Egy reduce-only piaci megbízást küld az ellenkező oldalra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "100% închide poziția. Trimite un ordin de piață reduce-only pe partea opusă."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "100% zatvara poziciju. Šalje reduce-only tržišni nalog na suprotnu stranu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "100% закриває позицію. Надсилається ринковий reduce-only ордер у протилежний бік."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
