    "trading.trailingStop.footer.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distance is the gap the stop maintains as price moves favourably. Min lock-in (optional) prevents the stop from moving below that profit threshold once reached."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odległość trailing stopu to odstęp, jaki stop utrzymuje względem ceny, gdy rynek porusza się na Twoją korzyść. Minimalne zabezpieczenie zysku (opcjonalne) zapobiega cofnięciu stopu poniżej wyznaczonego progu po jego osiągnięciu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Trailing-Abstand ist der Abstand, den der Stop einhält, wenn sich der Preis zu deinen Gunsten bewegt. Die minimale Gewinnsicherung (optional) verhindert, dass der Stop nach Erreichen unter diese Gewinnschwelle zurückläuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance de suivi est l'écart que le stop maintient lorsque le prix évolue favorablement. Le verrouillage minimum (facultatif) empêche le stop de redescendre sous ce seuil de gain une fois atteint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia del trailing es la separación que el stop mantiene a medida que el precio se mueve a tu favor. El bloqueo mínimo (opcional) evita que el stop retroceda por debajo de ese umbral de beneficio una vez alcanzado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza di trailing è lo scarto che lo stop mantiene quando il prezzo si muove a tuo favore. Il lock-in minimo (opzionale) impedisce allo stop di scendere sotto quella soglia di profitto una volta raggiunta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De trailingafstand is de marge die de stop aanhoudt naarmate de prijs in je voordeel beweegt. Minimale winstvergrendeling (optioneel) voorkomt dat de stop onder die winstdrempel zakt zodra die is bereikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância do trailing é o intervalo que o stop mantém enquanto o preço se move a seu favor. O lock-in mínimo (opcional) impede que o stop volte abaixo desse limite de lucro depois de atingido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-avståndet är gapet som stoppen håller medan priset rör sig till din fördel. Min vinstlås (valfritt) hindrar stoppen från att röra sig under den vinsttröskeln när den väl uppnåtts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-avstanden er gapet stoppen opprettholder mens prisen beveger seg i din favør. Minimum lock-in (valgfritt) hindrer at stoppen flyttes under den profittgrensen når den først er nådd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-afstand er det interval, stoppet opretholder, når prisen bevæger sig i favørretning. Min. profitlås (valgfri) forhindrer, at stoppet flyttes under den profittærskel, når den er nået."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seurantaetäisyys on väli, jonka stop pitää hintaan nähden markkinan liikkuessa edukseen. Minimivoiton lukitus (valinnainen) estää stopin liikkumisen voittotason alapuolelle sen jälkeen, kun taso on saavutettu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distance je odstup, který stop udržuje od ceny, když se trh pohybuje ve váš prospěch. Minimální zajištění zisku (volitelné) zabraňuje tomu, aby se stop po dosažení vrátil pod stanovenou ziskovou hranici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing vzdialenosť je odstup, ktorý si stop udržiava od ceny, keď sa trh pohybuje vo váš prospech. Minimálne zaistenie zisku (voliteľné) zabraňuje posunu stopu pod stanovenú hranicu zisku po jej dosiahnutí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A követési távolság az a rés, amelyet a stop tart az árhoz képest, amikor a piac kedvezően mozog. A minimális profitzár (opcionális) megakadályozza, hogy a stop az elért profitküszöb alá csússzon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanța de trail este intervalul pe care stopul îl menține pe măsură ce prețul evoluează favorabil. Blocarea minimă a profitului (opțional) împiedică stopul să coboare sub acel prag, odată atins."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing udaljenost je razmak koji stop održava dok se cijena kreće u vašu korist. Minimalno zaključavanje (neobavezno) sprječava pomicanje stopa ispod tog praga dobiti nakon što je dosegnut."
          }
        }
      }
    },
