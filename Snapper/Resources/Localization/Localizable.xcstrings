    "settings.accessibility.hint.logoutButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to sign out and return to login"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij dwukrotnie, aby się wylogować i wrócić do logowania"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um abzumelden und zur Anmeldung zurückzukehren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour vous déconnecter et revenir à l'écran de connexion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para cerrar sesión y volver al inicio de sesión"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per disconnetterti e tornare alla schermata di accesso"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltik om uit te loggen en terug te keren naar het inlogscherm"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para sair e voltar à tela de login"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltryck för att logga ut och återgå till inloggning"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å logge ut og gå tilbake til innlogging"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttryk for at logge ud og vende tilbage til login"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu ulos ja palaa kirjautumissivulle kaksoisnapauttamalla"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím se odhlásíte a vrátíte se na přihlášení"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým ťuknutím sa odhlásite a vrátite na prihlásenie"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson duplán a kijelentkezéshez és a bejelentkezési képernyőre való visszatéréshez"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge de două ori pentru a te deconecta și a reveni la autentificare"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite za odjavu i povratak na prijavu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі торкніться, щоб вийти й повернутися до екрана входу"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь, чтобы выйти и вернуться на экран входа"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite du kartus, kad atsijungtumėte ir grįžtumėte į prisijungimą"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties divreiz, lai izrakstītos un atgrieztos pieteikšanās logā"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite za odjavu i povratak na prijavu"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite za odjavu i povratak na prijavu"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Trokit dy herë për të dalë dhe për t'u kthyer te hyrja"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvípikkaðu til að skrá þig út og fara aftur í innskráningu"
