    "settings.connection.changeBackendMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching backend signs you out and clears local app state. You'll need to sign in again at the new URL."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana backendu wyloguje Cię i wyczyści lokalny stan aplikacji. Musisz zalogować się ponownie pod nowym URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel des Backends wirst du abgemeldet und der lokale App-Zustand wird gelöscht. Du musst dich unter der neuen URL erneut anmelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de backend vous déconnecte et efface l'état local de l'application. Vous devrez vous reconnecter à la nouvelle URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de backend cerrará tu sesión y borrará el estado local de la app. Tendrás que iniciar sesión de nuevo con la nueva URL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare backend ti disconnetterà e azzererà lo stato locale dell'app. Dovrai accedere di nuovo al nuovo URL."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het wisselen van backend word je uitgelogd en wordt de lokale app-status gewist. Je moet opnieuw inloggen op de nieuwe URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar o backend irá desconectá-lo e limpar o estado local do app. Será necessário entrar novamente na nova URL."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att byta backend loggar ut dig och rensar lokalt app-tillstånd. Du måste logga in igen på den nya URL:en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytte av backend logger deg ut og fjerner lokal apptilstand. Du må logge inn på nytt på den nye URL-en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved skift af backend bliver du logget ud, og den lokale apptilstand ryddes. Du skal logge ind igen på den nye URL."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Backendin vaihtaminen kirjaa sinut ulos ja tyhjentää sovelluksen paikallisen tilan. Sinun on kirjauduttava sisään uudelleen uudella URL-osoitteella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna backendu vás odhlásí a vymaže lokální stav aplikace. Budete se muset znovu přihlásit na nové URL."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena backendu vás odhlási a vymaže lokálny stav aplikácie. Budete sa musieť znova prihlásiť na novej URL."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A backend váltása kijelentkezteti Önt és törli a helyi alkalmazásállapotot. Az új URL-en újra be kell jelentkeznie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea backendului te deconectează și șterge starea locală a aplicației. Va trebui să te autentifici din nou la noul URL."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena backenda odjavit će vas i obrisati lokalno stanje aplikacije. Morat ćete se ponovno prijaviti na novom URL-u."
          }
        }
      }
    },
