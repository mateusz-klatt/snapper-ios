    "notifications.prefs.noDevice.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable push notifications in Settings → Notifications to register this device."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz powiadomienia push w Ustawienia → Powiadomienia, aby zarejestrować to urządzenie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Push-Benachrichtigungen unter Einstellungen → Benachrichtigungen, um dieses Gerät zu registrieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications push dans Réglages → Notifications pour enregistrer cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones push en Ajustes → Notificaciones para registrar este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita le notifiche push in Impostazioni → Notifiche per registrare questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel pushmeldingen in via Instellingen → Meldingen om dit apparaat te registreren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações push em Ajustes → Notificações para registrar este dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera push-aviseringar i Inställningar → Aviseringar för att registrera den här enheten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver push-varsler i Innstillinger → Varsler for å registrere denne enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér push-notifikationer i Indstillinger → Notifikationer for at registrere denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota push-ilmoitukset käyttöön kohdassa Asetukset → Ilmoitukset rekisteröidäksesi tämän laitteen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte push oznámení v Nastavení → Oznámení, abyste toto zařízení zaregistrovali."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite push upozornenia v Nastavenia → Upozornenia, aby sa toto zariadenie zaregistrovalo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a push értesítéseket a Beállítások → Értesítések menüben az eszköz regisztrálásához."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează notificările push din Setări → Notificări pentru a înregistra acest dispozitiv."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite push obavijesti u Postavke → Obavijesti za registraciju ovog uređaja."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть push-сповіщення в Налаштування → Сповіщення, щоб зареєструвати цей пристрій."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите push-уведомления в Настройки → Уведомления, чтобы зарегистрировать это устройство."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunkite push pranešimus per Nustatymai → Pranešimai, kad užregistruotumėte šį įrenginį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iespējojiet push paziņojumus sadaļā Iestatījumi → Paziņojumi, lai reģistrētu šo ierīci."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite push obaveštenja u Podešavanja → Obaveštenja da biste registrovali ovaj uređaj."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogući push obavještenja u Postavke → Obavještenja da registruješ ovaj uređaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivizo njoftimet push te Cilësime → Njoftime për ta regjistruar këtë pajisje."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kveiktu á push-tilkynningum í Stillingar → Tilkynningar til að skrá þetta tæki."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τις push ειδοποιήσεις στις Ρυθμίσεις → Ειδοποιήσεις για να εγγραφεί αυτή η συσκευή."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı kaydetmek için Ayarlar → Bildirimler'de push bildirimlerini etkinleştirin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-enable ang push notification sa Settings → Notifications upang irehistro ang device na ito."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayakan pemberitahuan push dalam Tetapan → Pemberitahuan untuk mendaftarkan peranti ini."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan notifikasi push di Pengaturan → Notifikasi untuk mendaftarkan perangkat ini."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa push notifications katika Mipangilio > Arifa ili kusajili kifaa hiki."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস নিবন্ধন করতে সেটিংস → নোটিফিকেশন-এ পুশ নোটিফিকেশন চালু করুন।"
          }
        }
      }
    },
