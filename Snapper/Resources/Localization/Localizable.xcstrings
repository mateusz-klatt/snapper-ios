    "backend.url.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Casual users can ignore this. Self-hosters set the URL of their own Snapper backend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykli użytkownicy mogą to zignorować. Self-hosterzy ustawiają tu URL własnego backendu Snappera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelegenheitsnutzer können dies ignorieren. Self-Hoster tragen hier die URL ihres eigenen Snapper-Backends ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs ordinaires peuvent ignorer ceci. Les self-hosters renseignent l'URL de leur propre backend Snapper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios normales pueden ignorar esto. Los self-hosters configuran aquí la URL de su propio backend de Snapper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti comuni possono ignorare questa opzione. I self-hoster impostano qui l'URL del proprio backend Snapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewone gebruikers kunnen dit negeren. Self-hosters stellen hier de URL van hun eigen Snapper-backend in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários comuns podem ignorar isto. Quem faz self-hosting define aqui a URL do próprio backend do Snapper."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanliga användare kan ignorera detta. Self-hosters anger URL:en till sin egen Snapper-backend."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlige brukere kan ignorere dette. Selv-hostere setter URL-en til sin egen Snapper-backend."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Almindelige brugere kan ignorere dette. Self-hostere angiver URL'en til deres egen Snapper-backend."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavalliset käyttäjät voivat ohittaa tämän. Itse hostaavat asettavat oman Snapper-backendinsa URL-osoitteen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžní uživatelé to mohou ignorovat. Self-hosteři zde nastavují URL vlastního backendu Snapper."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bežní používatelia to môžu ignorovať. Self-hosteri si tu nastavujú URL vlastného Snapper backendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átlagos felhasználók ezt figyelmen kívül hagyhatják. A self-host felhasználók itt állítják be saját Snapper backendjük URL-jét."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizatorii obișnuiți pot ignora această opțiune. Cei care găzduiesc propriul server setează aici URL-ul backendului Snapper."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obični korisnici mogu ovo zanemariti. Self-hosteri postavljaju URL vlastitog Snapper backenda."
          }
        }
      }
    },
    "backend.url.invalidDebug": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use https:// (or http:// for localhost in Debug). Origin only — no path, query, or fragment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj https:// (lub http:// dla localhost w Debug). Tylko origin — bez ścieżki, parametrów ani fragmentu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende https:// (oder http:// für localhost im Debug-Modus). Nur Origin — kein Pfad, keine Query, kein Fragment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez https:// (ou http:// pour localhost en Debug). Origine uniquement — sans chemin, requête ni fragment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https:// (o http:// para localhost en Debug). Solo origin — sin ruta, parámetros ni fragmento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https:// (o http:// per localhost in Debug). Solo origin — senza path, query o frammento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik https:// (of http:// voor localhost in Debug). Alleen origin — geen pad, query of fragment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use https:// (ou http:// para localhost em Debug). Somente a origem — sem caminho, query ou fragmento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd https:// (eller http:// för localhost i Debug). Endast origin — ingen sökväg, query eller fragment."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk https:// (eller http:// for localhost i Debug). Kun origin — ingen sti, spørring eller fragment."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug https:// (eller http:// for localhost i Debug). Kun origin — ingen sti, query eller fragment."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä https://-osoitetta (tai http:// localhostille Debug-tilassa). Vain origin — ei polkua, kyselyä tai fragmenttia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte https:// (nebo http:// pro localhost v režimu Debug). Pouze origin — bez cesty, dotazu či fragmentu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite https:// (alebo http:// pre localhost v Debug). Iba origin — bez cesty, parametrov či fragmentu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon https://-t (vagy http://-t localhost esetén Debug módban). Csak origin — útvonal, lekérdezés vagy fragmentum nélkül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește https:// (sau http:// pentru localhost în Debug). Doar origin — fără cale, parametri sau fragment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite https:// (ili http:// za localhost u Debugu). Samo origin — bez putanje, parametara ili fragmenta."
          }
        }
      }
    },
    "backend.url.invalidRelease": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use https://your-backend.example. Origin only — no path, query, or fragment. App Store builds reject http:// and self-signed certificates."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj https://your-backend.example. Tylko origin — bez ścieżki, parametrów ani fragmentu. Buildy App Store odrzucają http:// i certyfikaty self-signed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende https://your-backend.example. Nur Origin — kein Pfad, keine Query, kein Fragment. App-Store-Builds lehnen http:// und selbstsignierte Zertifikate ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez https://your-backend.example. Origine uniquement — sans chemin, requête ni fragment. Les builds App Store rejettent http:// et les certificats auto-signés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https://your-backend.example. Solo origin — sin ruta, parámetros ni fragmento. Las compilaciones de App Store rechazan http:// y los certificados autofirmados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https://your-backend.example. Solo origin — senza path, query o frammento. Le build per l'App Store rifiutano http:// e i certificati self-signed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik https://your-backend.example. Alleen origin — geen pad, query of fragment. App Store-builds weigeren http:// en self-signed certificaten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use https://seu-backend.exemplo. Somente a origem — sem caminho, query ou fragmento. Builds da App Store rejeitam http:// e certificados autoassinados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd https://your-backend.example. Endast origin — ingen sökväg, query eller fragment. App Store-byggen avvisar http:// och self-signed-certifikat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk https://your-backend.example. Kun origin — ingen sti, spørring eller fragment. App Store-bygg avviser http:// og selvsignerte sertifikater."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug https://your-backend.example. Kun origin — ingen sti, query eller fragment. App Store-builds afviser http:// og selvsignerede certifikater."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä https://your-backend.example. Vain origin — ei polkua, kyselyä tai fragmenttia. App Store -koonnit hylkäävät http://-osoitteet ja itse allekirjoitetut varmenteet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte https://your-backend.example. Pouze origin — bez cesty, dotazu či fragmentu. Buildy App Store odmítají http:// a self-signed certifikáty."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite https://your-backend.example. Iba origin — bez cesty, parametrov či fragmentu. Buildy App Store odmietajú http:// a self-signed certifikáty."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon https://your-backend.example formátumot. Csak origin — útvonal, lekérdezés vagy fragmentum nélkül. Az App Store buildek elutasítják a http://-t és a self-signed tanúsítványokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește https://your-backend.example. Doar origin — fără cale, parametri sau fragment. Versiunile App Store resping http:// și certificatele self-signed."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite https://your-backend.example. Samo origin — bez putanje, parametara ili fragmenta. App Store buildovi odbijaju http:// i self-signed certifikate."
          }
        }
      }
    },
