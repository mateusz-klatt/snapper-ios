    "notifications.prefs.section.userDefaults.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults apply when no per-device override matches an inbound alert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia domyślne mają zastosowanie, gdy żadne nadpisanie dla urządzenia nie pasuje do przychodzącego alertu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardeinstellungen greifen, wenn keine geräteindividuelle Überschreibung auf einen eingehenden Alarm passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs par défaut s'appliquent lorsque aucun remplacement spécifique à l'appareil ne correspond à une alerte entrante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores predeterminados se aplican cuando ninguna anulación de dispositivo coincide con una alerta entrante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori predefiniti si applicano quando nessun override del dispositivo corrisponde a un'allerta in arrivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardwaarden gelden wanneer geen apparaatspecifieke override overeenkomt met een binnenkomende alert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões se aplicam quando nenhuma substituição por dispositivo corresponde a um alerta recebido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardvärden gäller när inget enhetsspecifikt åsidosättande matchar ett inkommande larm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard gjelder når ingen enhetsspesifikk overstyring samsvarer med et innkommende varsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarder gælder, når ingen enheds-tilsidesættelse matcher en indkommende alarm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletukset ovat voimassa, kun mikään laitekohtainen ohitus ei vastaa saapuvaa hälytystä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí hodnoty se použijí, když žádné přepsání pro zařízení neodpovídá příchozímu upozornění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolené nastavenia platia, keď žiadny prepis zariadenia nezodpovedá prichádzajúcemu upozorneniu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértékek akkor érvényesülnek, ha egyetlen eszközszintű felülírás sem illeszkedik egy beérkező riasztásra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile implicite se aplică atunci când nicio suprascriere specifică dispozitivului nu se potrivește cu o alertă primită."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadane postavke primjenjuju se kad nijedna iznimka uređaja ne odgovara dolaznom upozorenju."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартні налаштування застосовуються, коли жодне перевизначення пристрою не відповідає вхідному сповіщенню."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения по умолчанию применяются, если ни одно переопределение устройства не подходит для входящего оповещения."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Numatytosios reikšmės taikomos, kai joks įrenginio nepaisymas neatitinka įeinančio įspėjimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklusējumi tiek piemēroti, kad ienākošajam brīdinājumam neatbilst neviens individuāls pārlabojums."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrazumevana podešavanja se primenjuju kada nijedan izuzetak uređaja ne odgovara dolaznom upozorenju."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadane vrijednosti primjenjuju se kada nijedna izmjena uređaja ne odgovara dolaznom upozorenju."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Parazgjedhjet zbatohen kur asnjë mbivendosje për pajisje nuk përputhet me një sinjalizim hyrës."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjálfgefnar stillingar gilda þegar engin tækissérstilling passar við innkomandi viðvörun."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προεπιλογές ισχύουν όταν καμία παράκαμψη ανά συσκευή δεν ταιριάζει σε εισερχόμενη ειδοποίηση."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılanlar, gelen bir uyarıyla eşleşen cihaza özel bir geçersiz kılma olmadığında uygulanır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalalapat ang mga default kapag walang per-device override na tumutugma sa papasok na alerto."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalai diguna pakai apabila tiada penggantian per-peranti sepadan dengan amaran masuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Default berlaku ketika tidak ada penggantian per-perangkat yang cocok dengan peringatan masuk."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults hutumika wakati hakuna override ya kifaa inayolingana na arifa inayoingia."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো per-device override ইনবাউন্ড অ্যালার্টের সঙ্গে না মিললে ডিফল্ট প্রযোজ্য হয়।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当没有任何设备覆盖项匹配传入提醒时，将应用默认设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當沒有符合傳入警示的裝置覆寫時，會套用預設值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信アラートに一致するデバイス別上書きがない場合、既定値が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신된 알림에 일치하는 기기별 재정의가 없을 때 기본값이 적용됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้นจะใช้เมื่อไม่มีการตั้งค่าแทนที่เฉพาะอุปกรณ์ที่ตรงกับการแจ้งเตือนขาเข้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định được áp dụng khi không có ghi đè thiết bị nào khớp với cảnh báo đến."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "inbound alert နှင့် ကိုက်ညီသော per-device override မရှိပါက defaults ကို အသုံးပြုပါသည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई प्रति-डिवाइस ओवरराइड आने वाले अलर्ट से मेल नहीं खाता, तो डिफॉल्ट लागू होते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبق الافتراضيات عندما لا يطابق أي تجاوز خاص بالجهاز تنبيهًا واردًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברירות המחדל חלות כשאין עקיפה לפי מכשיר שמתאימה להתראה נכנסת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌فرض‌ها زمانی اعمال می‌شوند که هیچ تنظیم اختصاصی دستگاه با هشدار ورودی مطابقت نداشته باشد."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լռելյայնները կիրառվում են, երբ սարքի որևէ վերագրում չի համապատասխանում մուտքային ազդանշանին։"
          }
        }
      }
    },
    "trading.bracket.footer.requirement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one of stop loss / take profit is required. Backend fires reduce-only protective orders when price crosses either level."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest co najmniej stop loss lub take profit. Backend wysyła ochronne zlecenia reduce-only, gdy cena przekroczy któryś z poziomów."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens Stop-Loss oder Take-Profit ist erforderlich. Das Backend sendet Reduce-Only-Schutzorder, sobald der Preis eine der beiden Schwellen überschreitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un stop loss ou take profit est requis. Le backend déclenche des ordres de protection reduce-only lorsque le prix franchit l'un des niveaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere al menos uno de stop loss o take profit. El backend envía órdenes protectoras reduce-only cuando el precio cruza cualquiera de los niveles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È richiesto almeno uno tra stop loss e take profit. Il backend invia ordini protettivi reduce-only quando il prezzo supera uno dei due livelli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten minste een stop loss of een take profit is vereist. De backend verstuurt reduce-only beschermingsorders zodra de prijs een van beide niveaus overschrijdt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos um entre stop loss e take profit é obrigatório. O backend dispara ordens de proteção reduce-only quando o preço cruzar qualquer um dos níveis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst en av stop loss / take profit krävs. Backend skickar reduce-only-skyddsordrar när priset korsar någon av nivåerna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst én av stop loss / take profit kreves. Backend sender beskyttende reduce-only-ordrer når prisen krysser et av nivåene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindst en af stop loss eller take profit er påkrævet. Backend udsender reduce-only beskyttelsesordrer, når prisen krydser et af niveauerne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaaditaan vähintään stop loss tai take profit. Backend lähettää reduce-only-suojaustoimeksiantoja, kun hinta ylittää jommankumman tason."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje se alespoň jedno ze stop loss / take profit. Backend odesílá ochranné reduce-only pokyny, jakmile cena překročí kteroukoli z úrovní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje sa aspoň jedno zo stop loss / take profit. Backend pri prekročení niektorej úrovne odošle ochranné pokyny reduce-only."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább egy stop loss vagy take profit szükséges. A backend reduce-only védelmi megbízásokat indít, amikor az ár átlépi bármelyik szintet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este necesar cel puțin un stop loss sau un take profit. Backendul trimite ordine de protecție reduce-only când prețul depășește unul dintre niveluri."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban je barem stop loss ili take profit. Backend šalje zaštitne reduce-only naloge kad cijena prijeđe neku od razina."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен принаймні stop loss або take profit. Backend надсилає захисні reduce-only ордери, коли ціна перетинає будь-який рівень."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется как минимум стоп-лосс или тейк-профит. Бэкенд отправляет защитные ордера reduce-only, когда цена пересекает любой из уровней."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reikalingas bent stop loss arba take profit. Backend'as siunčia tik mažinančius (reduce-only) apsauginius pavedimus, kai kaina kerta vieną iš lygių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepieciešams vismaz viens no stop loss / take profit. Backend nosūta reduce-only aizsardzības rīkojumus, kad cena šķērso kādu no līmeņiem."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban je barem stop-loss ili take-profit. Backend šalje zaštitne reduce-only naloge kada cena pređe neki od nivoa."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban je barem stop loss ili take profit. Backend šalje zaštitne reduce-only naloge kada cijena pređe jedan od nivoa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kërkohet të paktën një nga stop loss / take profit. Backend aktivizon porosi mbrojtëse vetëm reduktim kur çmimi kalon cilindo nivel."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "A.m.k. annað hvort stop-loss eða take-profit er krafist. Backend virkjar verndandi reduce-only pantanir þegar verð fer yfir annað hvort stigið."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται τουλάχιστον ένα από stop loss / take profit. Το backend υποβάλλει προστατευτικές εντολές reduce-only όταν η τιμή ξεπεράσει κάποιο από τα επίπεδα."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az stop loss veya take profit gerekir. Fiyat herhangi bir seviyeyi geçtiğinde backend, koruyucu reduce-only emirler gönderir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakailangan ang hindi bababa sa isa sa stop loss / take profit. Nagsusumite ang backend ng reduce-only protective orders kapag tumawid ang presyo sa alinmang level."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekurang-kurangnya satu daripada stop loss / take profit diperlukan. Backend mencetuskan pesanan perlindungan reduce-only apabila harga melintasi mana-mana paras."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setidaknya satu dari stop loss / take profit diperlukan. Backend memicu pesanan pelindung reduce-only ketika harga melewati salah satu level."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalau moja kati ya stop loss / take profit inahitajika. Backend huwasha order za ulinzi za reduce-only bei inapovuka mojawapo ya viwango."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপক্ষে একটি stop-loss / take-profit প্রয়োজন। দাম যেকোনো স্তর অতিক্রম করলে ব্যাকএন্ড reduce-only সুরক্ষামূলক অর্ডার চালু করে।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须至少设置止损或止盈之一。当价格突破任一水平时，后端会触发只减仓保护订单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要止損或止盈其中一項。當價格穿越任一水平時，後端會觸發只減倉保護訂單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストップロスまたはテイクプロフィットの少なくとも一方が必要です。価格がいずれかの水準に達すると、バックエンドが保護用のリデュースオンリー注文を発動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스탑로스 또는 테이크 프로핏 중 하나 이상이 필요합니다. 가격이 어느 한 수준을 통과하면 백엔드가 reduce-only 보호 주문을 실행합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมี stop-loss หรือ take-profit อย่างน้อยหนึ่งรายการ Backend จะส่งคำสั่งป้องกันแบบ reduce-only เมื่อราคาข้ามระดับใดระดับหนึ่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần ít nhất stop loss hoặc take profit. Backend gửi lệnh bảo vệ reduce-only khi giá vượt qua một trong các mức."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "stop-loss / take-profit အနည်းဆုံး တစ်ခု လိုအပ်သည်။ ဈေးနှုန်းသည် အဆင့်တစ်ခုခုကို ဖြတ်သွားသောအခါ Backend သည် reduce-only protective orders များကို fire လုပ်ပါသည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टॉप-लॉस / टेक-प्रॉफिट में से कम से कम एक जरूरी है। प्राइस किसी भी स्तर को पार करने पर बैकएंड रिड्यूस-ओनली प्रोटेक्टिव ऑर्डर ट्रिगर करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم تحديد وقف الخسارة أو جني الأرباح على الأقل. يرسل الخادم الخلفي أوامر حماية للتقليل فقط عندما يتجاوز السعر أيًا من المستويين."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש לפחות סטופ-לוס או take-profit אחד. הבקאנד מפעיל פקודות הגנה reduce-only כשהמחיר חוצה אחד מהרמות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداقل یکی از حد ضرر / حد سود لازم است. وقتی قیمت از هرکدام از این سطوح عبور کند، بک‌اند سفارش‌های محافظتی reduce-only را اجرا می‌کند."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահանջվում է առնվազն stop loss կամ take profit։ Backend-ը գործարկում է reduce-only պաշտպանական հանձնարարականներ, երբ գինը հատում է մակարդակներից որևէ մեկը։"
          }
        }
      }
    },
