    "backend.url.invalidDebug" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use https:// (or http:// for localhost in Debug). Origin only — no path, query, or fragment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj https:// (lub http:// dla localhost w Debug). Tylko origin — bez ścieżki, parametrów ani fragmentu."
          }
        }
      }
    },
    "backend.url.invalidRelease" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use https://your-backend.example. Origin only — no path, query, or fragment. App Store builds reject http:// and self-signed certificates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj https://your-backend.example. Tylko origin — bez ścieżki, parametrów ani fragmentu. Buildy App Store odrzucają http:// i certyfikaty self-signed."
