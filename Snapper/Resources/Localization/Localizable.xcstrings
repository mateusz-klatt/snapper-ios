          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "100% zatvara poziciju. Šalje reduce-only tržišni nalog na suprotnoj strani."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "100% e mbyll pozicionin. Dorëzon një porosi tregu vetëm reduktim kundër anës së kundërt."
