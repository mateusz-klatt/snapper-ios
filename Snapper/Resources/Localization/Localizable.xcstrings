    "positions.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positions will appear here when you have open orders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje pojawią się tu, gdy masz otwarte zlecenia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positionen erscheinen hier, sobald du offene Orders hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions apparaîtront ici lorsque vous aurez des ordres ouverts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones aparecerán aquí cuando tengas órdenes abiertas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le posizioni appariranno qui quando avrai ordini aperti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posities verschijnen hier zodra je open orders hebt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições aparecerão aqui quando você tiver ordens abertas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Positioner visas här när du har öppna ordrar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjoner vises her når du har åpne ordrer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Positioner vises her, når du har åbne ordrer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiot näkyvät täällä, kun sinulla on avoimia toimeksiantoja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozice se zde objeví, jakmile budete mít otevřené pokyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozície sa zobrazia tu, keď budete mať otvorené pokyny."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pozíciók itt jelennek meg, amikor nyitott megbízásai vannak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozițiile vor apărea aici când vei avea ordine deschise."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozicije će se pojaviti ovdje kad imate otvorene naloge."
          }
        }
      }
    },
