    "trading.trailingStop.footer.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distance is the gap the stop maintains as price moves favourably. Min lock-in (optional) prevents the stop from moving below that profit threshold once reached."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odległość trailing stopu to odstęp, jaki stop utrzymuje względem ceny, gdy rynek porusza się na Twoją korzyść. Minimalne zabezpieczenie zysku (opcjonalne) zapobiega cofnięciu stopu poniżej wyznaczonego progu po jego osiągnięciu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Trailing-Abstand ist der Abstand, den der Stop einhält, wenn sich der Preis zu deinen Gunsten bewegt. Die minimale Gewinnsicherung (optional) verhindert, dass der Stop nach Erreichen unter diese Gewinnschwelle zurückläuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance de suivi est l'écart que le stop maintient lorsque le prix évolue favorablement. Le verrouillage minimum (facultatif) empêche le stop de redescendre sous ce seuil de gain une fois atteint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia del trailing es la separación que el stop mantiene a medida que el precio se mueve a tu favor. El bloqueo mínimo (opcional) evita que el stop retroceda por debajo de ese umbral de beneficio una vez alcanzado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza di trailing è lo scarto che lo stop mantiene quando il prezzo si muove a tuo favore. Il lock-in minimo (opzionale) impedisce allo stop di scendere sotto quella soglia di profitto una volta raggiunta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De trailingafstand is de marge die de stop aanhoudt naarmate de prijs in je voordeel beweegt. Minimale winstvergrendeling (optioneel) voorkomt dat de stop onder die winstdrempel zakt zodra die is bereikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância do trailing é o intervalo que o stop mantém enquanto o preço se move a seu favor. O lock-in mínimo (opcional) impede que o stop volte abaixo desse limite de lucro depois de atingido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-avståndet är gapet som stoppen håller medan priset rör sig till din fördel. Min vinstlås (valfritt) hindrar stoppen från att röra sig under den vinsttröskeln när den väl uppnåtts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-avstanden er gapet stoppen opprettholder mens prisen beveger seg i din favør. Minimum lock-in (valgfritt) hindrer at stoppen flyttes under den profittgrensen når den først er nådd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-afstand er det interval, stoppet opretholder, når prisen bevæger sig i favørretning. Min. profitlås (valgfri) forhindrer, at stoppet flyttes under den profittærskel, når den er nået."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seurantaetäisyys on väli, jonka stop pitää hintaan nähden markkinan liikkuessa edukseen. Minimivoiton lukitus (valinnainen) estää stopin liikkumisen voittotason alapuolelle sen jälkeen, kun taso on saavutettu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distance je odstup, který stop udržuje od ceny, když se trh pohybuje ve váš prospěch. Minimální zajištění zisku (volitelné) zabraňuje tomu, aby se stop po dosažení vrátil pod stanovenou ziskovou hranici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing vzdialenosť je odstup, ktorý si stop udržiava od ceny, keď sa trh pohybuje vo váš prospech. Minimálne zaistenie zisku (voliteľné) zabraňuje posunu stopu pod stanovenú hranicu zisku po jej dosiahnutí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A követési távolság az a rés, amelyet a stop tart az árhoz képest, amikor a piac kedvezően mozog. A minimális profitzár (opcionális) megakadályozza, hogy a stop az elért profitküszöb alá csússzon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanța de trail este intervalul pe care stopul îl menține pe măsură ce prețul evoluează favorabil. Blocarea minimă a profitului (opțional) împiedică stopul să coboare sub acel prag, odată atins."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing udaljenost je razmak koji stop održava dok se cijena kreće u vašu korist. Minimalno zaključavanje (neobavezno) sprječava pomicanje stopa ispod tog praga dobiti nakon što je dosegnut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-дистанція — це відстань, яку стоп утримує, поки ціна рухається у вашу користь. Мінімальне зафіксування прибутку (необовʼязкове) запобігає поверненню стопу нижче встановленого порогу прибутку після його досягнення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистанция трейлинга — это расстояние, на котором стоп держится от цены при движении рынка в вашу пользу. Минимальная фиксация (необязательно) не даёт стопу опуститься ниже выбранного порога прибыли после его достижения."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing atstumas — tai tarpas, kurį stop'as išlaiko nuo kainos, kai rinka juda jums palankia kryptimi. Mažiausias pelno užfiksavimas (neprivaloma) neleidžia stop'ui pasitraukti žemiau pasiekto pelno slenksčio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekošanas attālums ir atstarpe, ko stop uztur, kamēr cena kustas labvēlīgi. Minimālā peļņas fiksācija (neobligāta) neļauj stop pārvietoties zem šī peļņas sliekšņa, tiklīdz tas ir sasniegts."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing rastojanje je razmak koji stop održava dok se cena kreće u vašu korist. Minimalno zaključavanje (opciono) sprečava pomeranje stopa ispod tog praga dobiti nakon što je dostignut."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distanca je razmak koji stop održava dok se cijena kreće u vašu korist. Minimalna zaštita profita (opcionalno) sprječava da se stop pomjeri ispod tog praga profita kada se jednom dostigne."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanca e trailing stop është hendeku që stopi ruan ndërsa çmimi lëviz në favorin tënd. Sigurimi minimal i fitimit (opsional) e pengon stopin të lëvizë poshtë atij pragu fitimi pasi arrihet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing-fjarlægð er bilið sem stop heldur þegar verð hreyfist þér í hag. Lágmarkslæsing hagnaðar (valfrjálst) kemur í veg fyrir að stop fari niður fyrir þann hagnaðarþröskuld eftir að honum er náð."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόσταση trailing είναι το κενό που διατηρεί το stop καθώς η τιμή κινείται ευνοϊκά. Το ελάχιστο κλείδωμα (προαιρετικό) εμποδίζει το stop να κινηθεί κάτω από αυτό το όριο κέρδους μόλις επιτευχθεί."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing mesafesi, fiyat lehte hareket ettikçe stop'un koruduğu açıklıktır. Minimum kâr kilidi (isteğe bağlı), ulaşıldıktan sonra stop'un bu kâr eşiğinin altına inmesini engeller."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang trailing distance ay ang puwang na pinapanatili ng stop habang gumagalaw nang pabor ang presyo. Pinipigilan ng min lock-in (opsyonal) na bumaba ang stop sa ibaba ng profit threshold na iyon kapag naabot na."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak trailing ialah jurang yang dikekalkan oleh stop apabila harga bergerak ke arah yang menguntungkan. Kunci-masuk min (pilihan) menghalang stop daripada bergerak di bawah ambang keuntungan tersebut setelah dicapai."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak trailing adalah jarak yang dipertahankan stop saat harga bergerak menguntungkan. Lock-in minimum (opsional) mencegah stop bergerak di bawah ambang keuntungan tersebut setelah tercapai."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distance ni nafasi ambayo stop hudumisha wakati bei inasonga kwa faida. Min lock-in (hiari) huzuia stop kushuka chini ya kizingiti hicho cha faida baada ya kufikiwa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রেইলিং দূরত্ব হলো দাম অনুকূলে চললে স্টপ যে ফাঁক বজায় রাখে। Min lock-in (ঐচ্ছিক) লক্ষ্য ছোঁয়ার পর স্টপকে সেই মুনাফা সীমার নিচে নামতে বাধা দেয়।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪距离是价格朝有利方向移动时止损保持的间距。最低锁利（可选）可防止止损在达到后回落到该盈利阈值以下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤距離是價格向有利方向移動時，止損維持的距離。最低鎖定收益（選填）可在達到後，防止止損移到該盈利門檻以下。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーリング距離は、価格が有利に動いたときにストップが維持する価格差です。最小ロックイン（任意）は、一度到達した利益水準を下回る位置にストップが移動するのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트레일링 거리는 가격이 유리한 방향으로 움직일 때 스탑이 유지하는 간격입니다. 최소 락인(선택)은 도달한 후 스탑이 해당 수익 임계값 아래로 이동하는 것을 방지합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะ trailing คือช่องว่างที่ stop รักษาไว้ขณะราคาเคลื่อนไปในทิศทางที่เป็นบวก การล็อกกำไรขั้นต่ำ(ไม่บังคับ)จะป้องกันไม่ให้ stop ขยับต่ำกว่าเกณฑ์กำไรนั้นหลังจากแตะแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách trail là khoảng mà stop giữ khi giá di chuyển có lợi. Khóa lợi nhuận tối thiểu (tùy chọn) ngăn stop lùi xuống dưới ngưỡng lợi nhuận đó sau khi đạt được."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing distance သည် ဈေးနှုန်း ကောင်းမွန်သောဘက်သို့ ရွေ့လျားသည့်အခါ stop က ထိန်းထားသော gap ဖြစ်သည်။ Min lock-in (optional) သည် အဆင့်ရောက်ပြီးနောက် stop ကို ထိုအမြတ် threshold အောက်သို့ မရွေ့အောင် ကာကွယ်သည်။"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रेलिंग दूरी वह गैप है जिसे स्टॉप तब बनाए रखता है जब प्राइस आपके पक्ष में चलता है। मिन लॉक-इन (वैकल्पिक) एक बार पहुंचने के बाद स्टॉप को उस प्रॉफिट थ्रेशोल्ड से नीचे जाने से रोकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسافة الوقف المتحرك هي الفجوة التي يحافظ عليها الوقف عندما يتحرك السعر لصالحك. الحد الأدنى لتثبيت الربح (اختياري) يمنع الوقف من الهبوط دون عتبة الربح بعد بلوغها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מרחק הסטופ הנגרר הוא הפער שהסטופ שומר כשהמחיר נע לטובתך. נעילת רווח מינימלית (אופציונלי) מונעת מהסטופ לרדת מתחת לסף הרווח הזה לאחר שהושג."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فاصله trailing stop فاصله‌ای است که استاپ هنگام حرکت مطلوب قیمت حفظ می‌کند. حداقل قفل سود (اختیاری) پس از رسیدن به آن، اجازه نمی‌دهد استاپ پایین‌تر از آستانه سود تعیین‌شده حرکت کند."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing stop-ի հեռավորությունը այն բացն է, որը stop-ը պահպանում է, երբ գինը շարժվում է շահավետ ուղղությամբ։ Min lock-in-ը (ոչ պարտադիր) թույլ չի տալիս, որ stop-ը իջնի այդ շահույթի շեմից ցածր՝ այն հասնելուց հետո։"
          }
        }
      }
    },
